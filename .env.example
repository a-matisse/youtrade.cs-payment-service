# Copy to .env. Use unquoted KEY=value lines (Spring properties syntax).
TRYBIT_API_KEY=
TRYBIT_SHOP_ID=
TRYBIT_SECRET_KEY=
# Optional, defaults to the production API:
# TRYBIT_BASE_URL=https://api.trybit.com/v2
# Cancellation fallback: scan today and yesterday (UTC) every 60 seconds.
# TRYBIT_POLL_ENABLED=true
# TRYBIT_POLL_INTERVAL_MS=60000
# TRYBIT_POLL_LOOKBACK_DAYS=2

# Existing service settings can also be supplied here:
# HELEKET_UUID=
# HELEKET_API=
# DB_UNAME=
# DB_PASSWORD=
